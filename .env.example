# Port mapping on the host (change this if 3000 is already in use, e.g. PORT=3001)
PORT=3000

# Database configuration (SQLite file path inside container)
DATABASE_URL=file:/data/spliit.db

# Authentication (JWT session secret)
AUTH_SECRET=development_secret_key_minimum_32_characters_long

# Session duration in days before requiring re-login (defaults to 365 days / 1 year)
# AUTH_SESSION_MAX_AGE_DAYS=365

# OAuth Providers (configure for production logins)
# Google OAuth:
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# GitHub OAuth:
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Public URL this instance is reachable at. Defaults to http://localhost:3000.
# BASE_URL=http://localhost:3000

# Default currency pre-selected when creating a new group. Defaults to USD.
# DEFAULT_CURRENCY_CODE=EUR

# Expense documents / receipt uploads (see README "Expense documents").
# ENABLE_EXPENSE_DOCUMENTS=true
# S3_UPLOAD_KEY=
# S3_UPLOAD_SECRET=
# S3_UPLOAD_BUCKET=
# S3_UPLOAD_REGION=auto
# S3_UPLOAD_ENDPOINT=
# Public base URL uploaded objects are read from. Read at runtime, so it can be
# set on a prebuilt image. Needed when the S3 endpoint is not public itself,
# e.g. Cloudflare R2 custom domains / r2.dev.
# S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# AI features (scan a receipt, split its line items, deduce a category)
# ---------------------------------------------------------------------------
# Nothing here runs until the matching flag is on. Receipt items imply receipt
# extraction; every flag needs an API key below.
# ENABLE_RECEIPT_EXTRACT=true        # create an expense by scanning a receipt
# ENABLE_RECEIPT_ITEMS=true          # break the scan down into line items
# NEXT_PUBLIC_ENABLE_RECEIPT_ITEMS=true
# ENABLE_CATEGORY_EXTRACT=true       # deduce the category from the title
#
# Spliit calls any endpoint that speaks the OpenAI Chat Completions API, so the
# AI_* variables below can point it at Google Gemini, Ollama, OpenRouter, Groq,
# a self-hosted gateway, ... instead of OpenAI. The provider must support
# structured outputs (response_format: json_schema) and, for receipt scanning,
# image input. The historical OPENAI_* names still work; AI_* wins when both
# are set.
#
# Google Gemini (its OpenAI-compatible endpoint):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=<your Google AI Studio API key>
# AI_MODEL_RECEIPT_EXTRACT=gemini-2.5-flash
# AI_MODEL_RECEIPT_ITEMS_EXTRACT=gemini-2.5-flash
# AI_MODEL_CATEGORY_EXTRACT=gemini-2.5-flash
#
# Ollama / LM Studio / any local server (the key is ignored but still required
# because the OpenAI SDK demands one):
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=not-needed
#
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL_RECEIPT_EXTRACT=          # defaults to gpt-5-nano
# AI_MODEL_RECEIPT_ITEMS_EXTRACT=    # defaults to the receipt-extract model
# AI_MODEL_CATEGORY_EXTRACT=         # defaults to gpt-5-nano
#
# Legacy spelling, kept for existing deployments:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL_RECEIPT_EXTRACT=
# OPENAI_MODEL_RECEIPT_ITEMS_EXTRACT=
# OPENAI_MODEL_CATEGORY_EXTRACT=
